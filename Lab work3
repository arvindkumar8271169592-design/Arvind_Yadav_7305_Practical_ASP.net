<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Contact.aspx.cs" Inherits="ContactUs.Contact" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Contact Us</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: #f2f4f7;
        }

        .container {
            width: 80%;
            margin: 50px auto;
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
        }

        h1 {
            text-align: center;
            color: #333;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #777;
            margin-bottom: 30px;
        }

        .row {
            display: flex;
            gap: 30px;
        }

        .left, .right {
            width: 50%;
        }

        .info-box {
            background: #f7f8fa;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 8px;
        }

        .info-box h3 {
            margin: 0 0 8px;
            color: #333;
        }

        label {
            display: block;
            margin-top: 12px;
            margin-bottom: 5px;
            font-weight: bold;
            color: #444;
        }

        .input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 6px;
            box-sizing: border-box;
        }

        textarea.input {
            height: 120px;
            resize: none;
        }

        .btn {
            margin-top: 18px;
            width: 100%;
            padding: 13px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 16px;
            cursor: pointer;
        }

        .btn:hover {
            background: #0056b3;
        }
    </style>
</head>

<body>
    <form id="form1" runat="server">

        <div class="container">

            <h1>Contact Us</h1>
            <p class="subtitle">
                We would love to hear from you. Please fill out the form below.
            </p>

            <div class="row">

                <!-- Left Side -->
                <div class="left">

                    <div class="info-box">
                        <h3>📍 Address</h3>
                        <p>123 Main Street, India</p>
                    </div>

                    <div class="info-box">
                        <h3>📞 Phone</h3>
                        <p>+91 98765 43210</p>
                    </div>

                    <div class="info-box">
                        <h3>✉ Email</h3>
                        <p>contact@example.com</p>
                    </div>

                    <div class="info-box">
                        <h3>🕐 Working Hours</h3>
                        <p>Monday - Saturday: 9:00 AM - 6:00 PM</p>
                    </div>

                </div>

                <!-- Right Side -->
                <div class="right">

                    <label>Name</label>
                    <asp:TextBox ID="txtName" runat="server"
                        CssClass="input"
                        placeholder="Enter your name">
                    </asp:TextBox>

                    <label>Email</label>
                    <asp:TextBox ID="txtEmail" runat="server"
                        CssClass="input"
                        placeholder="Enter your email">
                    </asp:TextBox>

                    <label>Subject</label>
                    <asp:TextBox ID="txtSubject" runat="server"
                        CssClass="input"
                        placeholder="Enter subject">
                    </asp:TextBox>

                    <label>Message</label>
                    <asp:TextBox ID="txtMessage" runat="server"
                        CssClass="input"
                        TextMode="MultiLine"
                        placeholder="Write your message">
                    </asp:TextBox>

                    <asp:Button ID="btnSend" runat="server"
                        Text="Send Message"
                        CssClass="btn" />

                </div>

            </div>

        </div>

    </form>
</body>
</html>
