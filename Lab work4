<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Blog.aspx.cs" Inherits="BlogPage.Blog" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>My Blog</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
        }

        .header {
            background: #007bff;
            color: white;
            padding: 25px;
            text-align: center;
        }

        .header h1 {
            margin: 0;
        }

        .container {
            width: 90%;
            margin: 30px auto;
        }

        .blog-grid {
            display: flex;
            gap: 25px;
            flex-wrap: wrap;
        }

        .blog-card {
            background: white;
            width: 30%;
            min-width: 280px;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.12);
            box-sizing: border-box;
        }

        .blog-card h2 {
            color: #333;
            margin-top: 0;
        }

        .date {
            color: #777;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .blog-card p {
            color: #555;
            line-height: 1.6;
        }

        .read-btn {
            display: inline-block;
            background: #007bff;
            color: white;
            padding: 10px 18px;
            border-radius: 5px;
            text-decoration: none;
            margin-top: 10px;
        }

        .read-btn:hover {
            background: #0056b3;
        }

        .footer {
            margin-top: 40px;
            background: #222;
            color: white;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>

<body>

<form id="form1" runat="server">

    <!-- Header -->
    <div class="header">
        <h1>My Blog</h1>
        <p>Welcome to my personal blog</p>
    </div>

    <!-- Blog Posts -->
    <div class="container">

        <div class="blog-grid">

            <div class="blog-card">
                <h2>Introduction to ASP.NET</h2>
                <div class="date">August 12, 2026</div>
                <p>
                    Learn the basics of ASP.NET and how to create
                    dynamic web applications using Web Forms.
                </p>
                <a href="#" class="read-btn">Read More</a>
            </div>

            <div class="blog-card">
                <h2>Learn Web Development</h2>
                <div class="date">August 10, 2026</div>
                <p>
                    Web development is an important skill.
                    Learn HTML, CSS, JavaScript and ASP.NET.
                </p>
                <a href="#" class="read-btn">Read More</a>
            </div>

            <div class="blog-card">
                <h2>Importance of Technology</h2>
                <div class="date">August 08, 2026</div>
                <p>
                    Technology has changed our daily life and
                    provides many opportunities for students.
                </p>
                <a href="#" class="read-btn">Read More</a>
            </div>

        </div>

    </div>

    <!-- Footer -->
    <div class="footer">
        <p>© 2026 My Blog | All Rights Reserved</p>
    </div>

</form>

</body>
</html>
