<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="CSSDemo.aspx.cs" Inherits="WebApplication1.CSSDemo" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>CSS Demo in ASP.NET</title>

    <style type="text/css">

        body {
            font-family: Arial;
            margin: 30px;
        }

        .heading {
            color: white;
            background-color: blue;
            padding: 10px;
            text-align: center;
        }

        .content {
            color: green;
            font-size: 18px;
            border: 2px solid black;
            padding: 15px;
            margin-top: 20px;
        }

        .btn {
            background-color: green;
            color: white;
            padding: 10px;
            border: none;
        }

    </style>

</head>

<body>

<form id="form1" runat="server">

    <h1 class="heading">ASP.NET CSS Demo</h1>

    <div class="content">

        <asp:Label ID="Label1" runat="server"
            Text="This page demonstrates the use of Cascading Style Sheets in ASP.NET.">
        </asp:Label>

        <br /><br />

        <asp:Button ID="Button1" runat="server"
            Text="Click Here"
            CssClass="btn"
            OnClick="Button1_Click" />

        <br /><br />

        <asp:Label ID="Label2" runat="server"></asp:Label>

    </div>

</form>

</body>
</html>
